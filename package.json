{
    "name": "moonshot-csgo",
    "version": "0.0.0",
    "private": true,
    "description": "Moonshot Open World browser FPS bootstrap",
    "type": "module",
    "scripts": {
        "audit:nav": "node tools/navAuditCli.ts",
        "build": "vite build",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "test": "node --test",
        "test:e2e": "playwright test",
        "test:e2e:prod": "npm run build && playwright test --config playwright.production.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "playcanvas": "2.23.2"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "@playcanvas/inspector": "0.2.0",
        "@playwright/test": "1.64.1",
        "eslint": "9.39.5",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.4"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
