# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Everything not listed keeps Pages' default (revalidate on every load), which suits the campus model, scene data
# and character model: they change together with the code.

# Vite's hashed bundle: a new release gets new file names.
/build/*
  Cache-Control: public, max-age=31536000, immutable

# Rarely-changed media: reuse for a day without asking, then refresh in the background for a week.
/assets/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/ui/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/branding/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/ammo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
